# connection.test.ts's on-the-fly CJS transpile of connection.ts and every
# local module it transitively imports (sync-folder-guard.ts, migrate.ts,
# migrations/index.ts, shared/format.ts, shared/types.ts, ...), written
# beside each one's own source, for spawned test processes; each test run
# cleans its own copies up, this is only a backstop against a copy
# surviving an interrupted run.
electron/**/*.compiled.*.cjs
# bridge.test.ts's esbuild bundle of preload/index.ts for the real-Electron
# sandboxed-preload proof (T-260828-09/bundle-preload.ts) — same backstop
# reasoning as the entry above, different naming since it's a genuine
# single-file bundle, not a per-file transpile.
electron/**/*.bundled.*.cjs
