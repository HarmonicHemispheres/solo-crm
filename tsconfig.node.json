{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "electron/main/**/*",
    "electron/preload/**/*",
    "electron/shared/**/*",
    "vitest.config.ts",
    "electron/renderer/styles/tokens.test.ts",
    "electron/renderer/components/sheets/fields.test.ts",
    "electron/renderer/components/shell/Rail.test.ts",
    "electron/renderer/views/Companies.css.test.ts",
    "electron/renderer/views/cadence-single-source.test.ts",
    "electron/renderer/views/revenue-single-source.test.ts",
    "electron/renderer/views/detail-header.css.test.ts",
    "scripts/**/*.ts",
    "eslint-rules/**/*.ts",
    "vitest-pools.test.ts"
  ]
}
